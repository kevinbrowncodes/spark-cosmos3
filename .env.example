# Copy to .env and fill in. .env is gitignored — never commit it.

# Hugging Face token (needed to download the gated nvidia/Cosmos3-Nano weights;
# runtime is offline so it is only strictly required for downloads).
# Tip: HF_TOKEN=$(cat ~/.cache/huggingface/token)
HF_TOKEN=

# Host path of the Hugging Face cache holding the Cosmos3-Nano weights.
# Default: ~/.cache/huggingface
#HF_CACHE_DIR=

# Host path mounted at /media inside the container (input images, neg.json).
# Default: ~/Documents/cosmos-media
#COSMOS_MEDIA_DIR=

# Anthropic API key for the gateway's prompt upsampler (structured JSON
# prompts per the Cosmos tech report §6.3.2). Leave empty to disable
# upsampling — the gateway falls back to prose prompts.
ANTHROPIC_API_KEY=

# Flow UI sidecar (EPIC_002). One flow release tag pins BOTH the flow-protocol
# package and the UI bundle baked into the flow image. Upgrade the UI by
# bumping this, rebuilding (./scripts/deploy.sh) and re-running conformance:
#   docker compose exec flow flow-conformance http://localhost:8003
# Default: v0.2.0
#FLOW_VERSION=v0.2.0

# Host path mounted at /media inside the flow container: references you upload
# through the UI and cached finished clips. Default: ~/Documents/flow-media
#FLOW_MEDIA_DIR=

# The flow container runs as this uid:gid so the clips and run files it writes
# into FLOW_MEDIA_DIR belong to you, not root (BUG_008). Default: 1000:1000
#FLOW_UID=1000
#FLOW_GID=1000

# The Flow agent's planner (EPIC_003) uses the same Ollama/Gemma as the gateway's
# upsampler. These default to the gateway's values; set them only to diverge.
#GEMMA_URL=http://host.docker.internal:11434
#GEMMA_MODEL=gemma4:26b

# The agent's executor (STORY_030): it refuses to submit a clip below this much
# free memory (GiB, host-wide) and pauses the run instead; ticks every N seconds.
#AGENT_MIN_FREE_GIB=30
#AGENT_TICK_S=5
